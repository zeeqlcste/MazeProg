<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MazeProg - Student Waiting Room</title>
  <link rel="stylesheet" href="css/style.css">
  <style>
    body {
      background: #0f172a;
      color: #fff;
      font-family: Arial, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0;
      position: relative;
      overflow: hidden;
    }

    /* SPOTIFY FLOATING & DRAGGABLE WIDGET */
    .spotify-floating-widget {
      position: fixed;
      top: 20px;
      right: 20px; /* Kedudukan asal di atas kanan skrin */
      width: 320px;
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.6);
      z-index: 9999;
      user-select: none;
    }

    /* BAR HARAM UNTUK TARIK / DRAG */
    .drag-header {
      padding: 6px 12px;
      background: #0f172a;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
      cursor: move;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 11px;
      color: #94a3b8;
      font-weight: bold;
      border-bottom: 1px solid #334155;
    }

    .waiting-card {
      background: #1e293b;
      border: 1px solid #334155;
      border-radius: 12px;
      padding: 25px;
      width: 90%;
      max-width: 450px;
      text-align: center;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }

    .pin-badge {
      background: #38bdf8;
      color: #0f172a;
      font-size: 24px;
      font-weight: bold;
      padding: 6px 16px;
      border-radius: 8px;
      display: inline-block;
      margin-bottom: 15px;
      letter-spacing: 2px;
    }

    .session-topic-title {
      font-size: 22px;
      font-weight: bold;
      color: #f8fafc;
      margin: 10px 0;
      line-height: 1.3;
      word-break: break-word;
    }

    .status-text {
      color: #10b981;
      font-size: 14px;
      margin-top: 20px;
      margin-bottom: 20px;
      font-weight: bold;
    }

    .pulse-dot {
      display: inline-block;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #10b981;
      margin-right: 6px;
      animation: pulse 1.5s infinite;
    }

    .btn-leave {
      background: transparent;
      color: #ef4444;
      border: 1px solid #ef4444;
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
      width: 100%;
      transition: all 0.2s ease;
    }

    .btn-leave:hover {
      background: #ef4444;
      color: #fff;
    }

    @keyframes pulse {
      0% { transform: scale(0.95); opacity: 0.7; }
      50% { transform: scale(1.2); opacity: 1; }
      100% { transform: scale(0.95); opacity: 0.7; }
    }
  </style>
</head>
<body>

  <!-- FLOATING SPOTIFY PLAYER (BOLEH DRAG KANAN/KIRI/ATAS/BAWAH) -->
  <div id="spotifyWidget" class="spotify-floating-widget">
