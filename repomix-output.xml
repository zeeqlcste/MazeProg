  <title>MazeProg - Student Profile</title>
  <link rel="stylesheet" href="css/style.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background: #090d16; color: #fff; min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 20px; }
    
    .profile-card { width: 100%; max-width: 550px; background: #111827; border: 1px solid #1f2937; border-radius: 16px; padding: 28px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); }
    .header-title { font-size: 20px; font-weight: 700; color: #f3f4f6; text-align: center; margin-bottom: 20px; text-transform: uppercase; }
    
    /* Area Drag & Drop Gambar Avatar */
    .avatar-wrapper { position: relative; width: 120px; height: 120px; margin: 0 auto 20px; text-align: center; cursor: pointer; }
    .avatar-img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 3px solid #3b82f6; box-shadow: 0 0 12px rgba(59, 130, 246, 0.4); transition: 0.2s; }
    
    .avatar-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      border-radius: 50%; background: rgba(0, 0, 0, 0.6);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.2s; color: #fff; font-size: 11px; text-align: center; padding: 8px;
    }
    .avatar-wrapper:hover .avatar-overlay, .avatar-wrapper.dragover .avatar-overlay { opacity: 1; }
    .avatar-wrapper.dragover .avatar-img { border-color: #10b981; transform: scale(1.05); }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .form-group { text-align: left; margin-bottom: 12px; }
    .form-group label { display: block; font-size: 12px; color: #9ca3af; margin-bottom: 4px; font-weight: 500; }
    .form-control { width: 100%; background: #030712; border: 1px solid #1f2937; padding: 10px; border-radius: 8px; color: #fff; font-size: 13px; outline: none; }
    .form-control:focus { border-color: #3b82f6; box-shadow: 0 0 6px rgba(59, 130, 246, 0.3); }
    .form-control:disabled { opacity: 0.5; cursor: not-allowed; background: #111827; }

    .btn-save { width: 100%; background: #10b981; border: none; padding: 12px; color: #fff; font-weight: bold; border-radius: 8px; cursor: pointer; font-size: 14px; margin-top: 10px; }
    .btn-save:hover { background: #059669; }
    
    .btn-back { width: 100%; background: transparent; border: 1px solid #374151; padding: 10px; color: #9ca3af; font-weight: 600; border-radius: 8px; cursor: pointer; font-size: 13px; margin-top: 8px; }
    .btn-back:hover { background: #1f2937; color: #fff; }

    .btn-logout { width: 100%; background: #ef4444; border: none; padding: 10px; color: #fff; font-weight: 600; border-radius: 8px; cursor: pointer; font-size: 13px; margin-top: 12px; }
    .btn-logout:hover { background: #dc2626; }
  </style>
</head>
<body>

  <div class="profile-card">
    <a class="site-brand site-brand--compact" href="student-dashboard.html" aria-label="MazeProg student dashboard"><img src="assets/mazeprog-logo.png" alt="MazeProg"></a>
    <h2 class="header-title">Student Profile</h2>

    <!-- Avatar Drag and Drop Zone -->
    <div class="avatar-wrapper" id="avatarDropZone" title="Klik atau seret gambar ke sini">
      <img id="profilePreview" class="avatar-img" src="https://via.placeholder.com/120" alt="Avatar Preview">
      <div class="avatar-overlay">
        <span>📷 Klik / Drag Gambar</span>
      </div>
      <!-- Hidden File Input -->
      <input type="file" id="fileInput" accept="image/*" style="display: none;">
    </div>

    <form id="profileForm">
      <div class="form-grid">
        <div class="form-group">
          <label for="nameInput">Full Name</label>
          <input type="text" id="nameInput" class="form-control" required placeholder="Memuatkan...">
        </div>

        <div class="form-group">
          <label for="emailInput">Email (Read-only)</label>
          <input type="email" id="emailInput" class="form-control" disabled placeholder="Memuatkan...">
        </div>

