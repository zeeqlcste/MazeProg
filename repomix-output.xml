        .shared-code-card[hidden] { display: none; }
        .shared-code-card header { height: auto; padding: 10px 14px; border-bottom: 1px solid #31453a; color: #d8b977; font-size: 12px; }
        .shared-code-card pre { margin: 0; padding: 16px; overflow: auto; color: #d7f4e6; font: 15px/1.6 'Cascadia Code', Consolas, monospace; white-space: pre; }
        .student-note { position: absolute; z-index: 5; width: 190px; min-height: 120px; padding: 12px; border-radius: 6px; color: #16211b; white-space: pre-wrap; overflow-wrap: anywhere; box-shadow: 0 8px 22px rgba(0, 0, 0, 0.25); }
        .student-note small { display: block; margin-top: 12px; color: inherit; opacity: 0.7; text-align: right; }
        .board-container { background-color: #09110e; background-image: linear-gradient(rgba(96, 214, 174, 0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(96, 214, 174, 0.045) 1px, transparent 1px); background-size: 28px 28px; }
        .board-container canvas { background: transparent; }
        body.projector-mode .wb-header { display: none; }
        body.projector-mode .board-container { height: 100vh; }
        @media (max-width: 600px) { .shared-code-card { top: 8px; left: 8px; width: calc(100% - 16px); } }


        /* EXIT BUTTON */

        .btn-leave {

