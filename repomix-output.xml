      <h3 style="color: #38bdf8;">Add Question Set to this Session</h3>
      <div id="bankSetsContainer" style="margin: 15px 0; max-height: 250px; overflow-y: auto;"></div>
      <button id="confirmAddSetsBtn" class="btn btn-primary" style="width: 100%;">Add Selected Sets</button>
    </div>
  </div>

  <script type="module" src="js/lecturer-session-room.js"></script>
</body>
</html>
