import { database } from "./firebase-config.js";
import { ref, get, update, child } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

const userString = localStorage.getItem('loggedInUser');
const currentUser = userString ? JSON.parse(userString) : null;
const userId = currentUser ? (currentUser.user_id || currentUser.uid || currentUser.id) : null;

if (!currentUser || !userId || currentUser.role !== 'lecturer') {
  window.location.href = currentUser?.role === 'student' ? 'student-dashboard.html' : 'login.html';
}

const profileForm = document.getElementById('lecturerProfileForm');
const nameInput = document.getElementById('lecturerName');
const emailInput = document.getElementById('lecturerEmail');
const facultyInput = document.getElementById('lecturerFaculty');
const departmentInput = document.getElementById('lecturerDepartment');
const imageInput = document.getElementById('profileImageInput');
const imagePreview = document.getElementById('profileImagePreview');
const profileInitials = document.getElementById('profileInitials');
const statusText = document.getElementById('profileStatus');
let selectedProfileImage = '';

async function loadProfile() {
  try {
    const databaseRef = ref(database);
    const [userSnapshot, lecturerSnapshot] = await Promise.all([
      get(child(databaseRef, `USER/${userId}`)),
      get(child(databaseRef, `LECTURER/${userId}`))
    ]);
    const userData = userSnapshot.val() || currentUser;
    const lecturerData = lecturerSnapshot.val() || {};

    nameInput.value = userData.name || currentUser.name || '';
    emailInput.value = userData.email || currentUser.email || '';
    facultyInput.value = lecturerData.faculty || currentUser.faculty || '';
    departmentInput.value = lecturerData.department || currentUser.department || '';
    selectedProfileImage = userData.profile_picture || currentUser.profile_picture || '';
    profileInitials.textContent = (nameInput.value.trim()[0] || 'L').toUpperCase();
    if (selectedProfileImage) showProfileImage(selectedProfileImage);
  } catch (error) {
    console.error('Unable to load lecturer profile:', error);
    statusText.textContent = 'Could not load profile details.';
  }
}

imageInput.addEventListener('change', (event) => {
  const imageFile = event.target.files?.[0];
  if (!imageFile) return;
  if (!imageFile.type.startsWith('image/')) {
    statusText.textContent = 'Please select an image file.';
    imageInput.value = '';
    return;
  }

  const reader = new FileReader();
  reader.onload = () => {
    selectedProfileImage = String(reader.result || '');
    showProfileImage(selectedProfileImage);
  };
  reader.readAsDataURL(imageFile);
});

function showProfileImage(source) {
  imagePreview.src = source;
  imagePreview.hidden = false;
  profileInitials.hidden = true;
}

profileForm.addEventListener('submit', async (event) => {
  event.preventDefault();
  const saveButton = profileForm.querySelector('[type="submit"]');
  const name = nameInput.value.trim();
  if (!name) {
    statusText.textContent = 'Name is required.';
    return;
  }

  saveButton.disabled = true;
  statusText.textContent = 'Saving profile...';
  try {
    const userUpdates = { name };
    if (selectedProfileImage) userUpdates.profile_picture = selectedProfileImage;

    await Promise.all([
      update(ref(database, `USER/${userId}`), userUpdates),
      update(ref(database, `LECTURER/${userId}`), {
        user_id: userId,
        faculty: facultyInput.value.trim(),
        department: departmentInput.value.trim()
      })
    ]);

    currentUser.name = name;
    currentUser.faculty = facultyInput.value.trim();
    currentUser.department = departmentInput.value.trim();
    if (selectedProfileImage) currentUser.profile_picture = selectedProfileImage;
    localStorage.setItem('loggedInUser', JSON.stringify(currentUser));
    statusText.textContent = 'Profile updated successfully.';
  } catch (error) {
    console.error('Unable to save lecturer profile:', error);
    statusText.textContent = `Could not save profile: ${error.message}`;
  } finally {
    saveButton.disabled = false;
  }
});

document.getElementById('backToLecturerDashboard').addEventListener('click', () => {
  window.location.href = 'lecturer-dashboard.html';
});

document.getElementById('lecturerLogoutBtn').addEventListener('click', () => {
  if (confirm('Are you sure you want to log out?')) {
    localStorage.removeItem('loggedInUser');
    window.location.href = 'login.html';
  }
});

loadProfile();
</file>

<file path="js/lecturer-session-room.js">
import { database } from "./firebase-config.js";
import { ref, onValue, update } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

// Get PIN from URL Parameter (e.g. lecturer-session-room.html?pin=123456)
const urlParams = new URLSearchParams(window.location.search);
const currentPin = urlParams.get('pin');

if (!currentPin) {
  alert("No Game PIN provided!");
  window.location.href = 'create-game-session.html';
}

// DOM Elements
const lobbyPinDisplay = document.getElementById('lobbyPinDisplay');
const sessionTitleDisplay = document.getElementById('sessionTitleDisplay');
const themeBadge = document.getElementById('themeBadge');
const themeBanner = document.getElementById('themeBanner');
const playersList = document.getElementById('playersList');
const playerCount = document.getElementById('playerCount');
const sessionQuestionsContainer = document.getElementById('sessionQuestionsContainer');
const startGameBtn = document.getElementById('startGameBtn');

// Modal Elements
const addSetModal = document.getElementById('addSetModal');
const openAddQuestionModalBtn = document.getElementById('openAddQuestionModalBtn');
const closeAddSetModalBtn = document.getElementById('closeAddSetModalBtn');
const bankSetsContainer = document.getElementById('bankSetsContainer');
const confirmAddSetsBtn = document.getElementById('confirmAddSetsBtn');

let currentSessionData = {};
let cachedQuestionBank = {};
let activeQuestionList = []; // Merged questions list
let draggedIndex = null; // Menyimpan indeks item yang sedang di-drag
let isCustomized = false; // Elak overwrite jika lecturer dah delete/reorder soalan
let gameStarted = false; // Kenapa game dah mula (status IN_GAME / IN_PROGRESS)
let currentPlayers = null; // Salinan data pemain terkini supaya leaderboard boleh render sekali tukar view

// DOM Elements - Leaderboard
const leaderboardPanel = document.getElementById('leaderboardPanel');
const leaderboardBody = document.getElementById('leaderboardBody');
const leaderboardSummary = document.getElementById('leaderboardSummary');
const lobbyGrid = document.getElementById('lobbyGrid');
const bannerHint = document.getElementById('bannerHint');

if (lobbyPinDisplay) lobbyPinDisplay.textContent = currentPin;

// Theme Visual Styling Helper
const themeStyles = {
  cyberpunk: { bg: 'linear-gradient(135deg, #0f172a, #1e1b4b)', badge: '🌃 Cyberpunk', border: '#a855f7' },
  dungeon: { bg: 'linear-gradient(135deg, #1c1917, #292524)', badge: '🏰 Dungeon', border: '#f97316' },
  galaxy: { bg: 'linear-gradient(135deg, #030712, #0f172a)', badge: '🚀 Space Galaxy', border: '#38bdf8' },
  forest: { bg: 'linear-gradient(135deg, #064e3b, #022c22)', badge: '🌲 Mystic Forest', border: '#10b981' }
};

// 1. LISTEN TO SESSION DATA
const sessionRef = ref(database, `GAME_SESSIONS/${currentPin}`);
onValue(sessionRef, (snapshot) => {
  if (!snapshot.exists()) {
    alert("Session not found!");
    window.location.href = 'create-game-session.html';
    return;
  }

  currentSessionData = snapshot.val();
  if (sessionTitleDisplay) sessionTitleDisplay.textContent = currentSessionData.session_title;

  // Set Theme
  if (currentSessionData.theme) {
    document.body.setAttribute('data-theme', currentSessionData.theme);
  }

  const themeInfo = themeStyles[currentSessionData.theme] || themeStyles.cyberpunk;
  if (themeBadge) themeBadge.textContent = themeInfo.badge;
  if (themeBanner) {
    themeBanner.style.background = themeInfo.bg;
    themeBanner.style.borderColor = themeInfo.border;
  }

  // Tukar paparan lobby / leaderboard mengikut status sesi
  const sessionStatus = currentSessionData.status || 'WAITING';
  toggleGameView(isInGameStatus(sessionStatus));

  // Jika DB sudah ada custom_questions (soalan yang diedit/delete/reorder), utamakan data tersebut
  if (currentSessionData.custom_questions && currentSessionData.custom_questions.length > 0) {
    activeQuestionList = currentSessionData.custom_questions;
    isCustomized = true;
    renderQuestionsList();
  } else {
    loadAndRenderQuestions();
  }
});

// ==========================================
// Leaderboard helpers
// ==========================================
function isInGameStatus(status) {
  return status === 'IN_GAME' || status === 'IN_PROGRESS';
}

function toggleGameView(inGame) {
  gameStarted = inGame;
  if (leaderboardPanel) leaderboardPanel.style.display = inGame ? '' : 'none';
  if (lobbyGrid) lobbyGrid.style.display = inGame ? 'none' : '';

  if (startGameBtn) {
    if (inGame) {
      startGameBtn.textContent = '🟢 Game in Progress';
      startGameBtn.disabled = true;
    } else {
      startGameBtn.textContent = '🚀 START GAME NOW';
      startGameBtn.disabled = false;
    }
  }

  // Kunci pemindahan / padam soalan semasa game berjalan
  document.querySelectorAll('.del-btn').forEach((btn) => {
    btn.disabled = inGame;
    btn.style.opacity = inGame ? '0.5' : '1';
  });

  if (bannerHint) {
    bannerHint.textContent = inGame
      ? 'Game in progress - students are playing now'
      : 'Students are joining using the PIN above.';
  }

  // Paparkan leaderboard dengan data murid yang sudah diketahui apabila tukar ke view game
  if (inGame && currentPlayers && leaderboardBody) {
    renderLeaderboard(currentPlayers);
  }
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text === undefined || text === null ? '' : String(text);
  return div.innerHTML;
}

function playerStatus(p) {
  const progress = p.progress || {};
  const status = progress.status || p.status;
  const lastUpdated = Number(progress.last_updated || p.last_updated || 0);
  const now = Date.now();
  const idleMs = now - lastUpdated;

  if (status === 'COMPLETED' || progress.is_completed) return 'finished';
  if (status === 'IN_PROGRESS' || status === 'IN_GAME') {
    if (idleMs > 60000) return 'idle';
    return 'playing';
  }
  return 'waiting';
}

function currentQuestionNum(p) {
  const progress = p.progress || {};
  const current = Number(progress.current_question_index || 0);
  const total = Number(progress.total_questions || activeQuestionList.length || 0);
  if (current > 0 && total > 0) return `${current} / ${total}`;
  if (current > 0) return `Q${current}`;
  return '-';
}

function renderLeaderboard(players) {
  if (!leaderboardBody) return;
  leaderboardBody.innerHTML = '';

  const pKeys = players ? Object.keys(players) : [];

  // Summary strip
  let playing = 0, finished = 0, idle = 0, waiting = 0;
  let totalScore = 0;
  pKeys.forEach((key) => {
    const p = players[key];
    const st = playerStatus(p);
    if (st === 'playing') playing++;
    else if (st === 'finished') finished++;
    else if (st === 'idle') idle++;
    else waiting++;
    totalScore += Number(p.score || 0);
  });

  if (leaderboardSummary) {
    const avg = pKeys.length ? Math.round(totalScore / pKeys.length) : 0;
    leaderboardSummary.innerHTML = `
      <span>👥 ${pKeys.length} students</span>
      <span>🟢 ${playing} playing</span>
      <span>⏸️ ${idle} idle</span>
      <span>✅ ${finished} finished</span>
      <span>⭐ Avg score: ${avg}</span>
    `;
  }

  if (pKeys.length === 0) {
    leaderboardBody.innerHTML = '<tr><td class="lb-empty" colspan="8">No students joined yet.</td></tr>';
    return;
  }

  const rows = pKeys.map((key) => {
    const p = players[key];
    const progress = p.progress || {};
    const score = Number(p.score || 0);
    const correct = Number(progress.correct_attempts || 0);
    const totalAttempts = Number(progress.total_attempts || 0);
    const accuracy = totalAttempts ? Math.round((correct / totalAttempts) * 100) : 0;
    const streak = Number(p.bestStreak || p.streak || 0);
    const status = playerStatus(p);
    return {
      key,
      name: p.name || key,
      score,
      correct,
      totalAttempts,
      accuracy,
      streak,
      status,
      qText: currentQuestionNum(p),
      time_taken: Number(progress.time_taken || 0)
    };
  });

  // Sort: score tertinggi dulu, baru correct lebih banyak, baru masa lebih cepat
  rows.sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    if (b.correct !== a.correct) return b.correct - a.correct;
    return a.time_taken - b.time_taken;
  });

  const rankEmoji = ['🥇', '🥈', '🥉'];

  rows.forEach((row, idx) => {
    const tr = document.createElement('tr');
    const isTop = idx < 3;
    if (isTop) tr.classList.add('lb-row-top');

    const statusClass =
      row.status === 'finished' ? 'lb-status-finished' :
      row.status === 'playing' ? 'lb-status-playing' :
      row.status === 'idle' ? 'lb-status-idle' : 'lb-status-waiting';

    const qProgress = row.qText;

    tr.innerHTML = `
      <td class="lb-rank">${isTop ? rankEmoji[idx] : idx + 1}</td>
      <td><span style="font-weight: 600;">${escapeHtml(row.name)}</span></td>
      <td><span class="lb-score">${row.score}</span></td>
      <td>${escapeHtml(qProgress)}</td>
      <td>
        <div class="lb-bar"><div style="width: 0%;"></div></div>
        <span class="lb-sub">${qProgress}</span>
      </td>
      <td>${row.accuracy}%</td>
      <td>${row.streak} <span class="lb-sub">🔥</span></td>
      <td><span class="${statusClass}">${escapeHtml(row.status.charAt(0).toUpperCase() + row.status.slice(1))}</span></td>
    `;
    leaderboardBody.appendChild(tr);
  });
}

// 2. LISTEN TO JOINED PLAYERS REAL-TIME
const playersRef = ref(database, `GAME_SESSIONS/${currentPin}/players`);
onValue(playersRef, (snapshot) => {
  const players = snapshot.exists() ? snapshot.val() : null;
  currentPlayers = players;
  const pKeys = players ? Object.keys(players) : [];

  if (playerCount) playerCount.textContent = `${pKeys.length} ${pKeys.length === 1 ? 'Player' : 'Players'}`;

  // Semasa game berjalan, paparkan leaderboard bukan senarai chip menunggu
  if (gameStarted) {
    renderLeaderboard(players);
    return;
  }

  if (!playersList) return;
  playersList.innerHTML = '';
  if (players) {
    pKeys.forEach((key) => {
      const p = players[key];
      const pBadge = document.createElement('div');
      pBadge.className = 'session-player-chip';
      pBadge.style.cssText = "background: #0f172a; border: 1px solid #38bdf8; color: #fff; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: bold;";
      pBadge.textContent = `🎮 ${p.name || key}`;
      playersList.appendChild(pBadge);
    });
  } else {
    playersList.innerHTML = '<p style="color: #64748b; font-size: 13px;">Waiting for students to join...</p>';
  }
});

// 3. FETCH QUESTION BANK & BUILD MERGED QUESTIONS LIST
const bankRef = ref(database, 'QUESTIONS');
onValue(bankRef, (snapshot) => {
  if (snapshot.exists()) {
    cachedQuestionBank = snapshot.val();
    if (!isCustomized) {
      loadAndRenderQuestions();
    }
  }
});

function loadAndRenderQuestions() {
  if (!currentSessionData.question_set_ids || !cachedQuestionBank) return;

  // Jika soalan belum disunting secara manual, jana senarai daripada set IDs
  if (activeQuestionList.length === 0 && !isCustomized) {
    currentSessionData.question_set_ids.forEach((setId) => {
      const qSet = cachedQuestionBank[setId];
      if (qSet && qSet.items) {
        Object.keys(qSet.items).forEach((itemKey) => {
          activeQuestionList.push({
            setId: setId,
            itemKey: itemKey,
            data: qSet.items[itemKey]
          });
        });
      }
    });
  }

  renderQuestionsList();
}

// FUNGSI KHAS: KEMAS KINI DB BILA DELETE / REORDER / ADD SET
async function syncQuestionsToDB() {
  try {
    await update(ref(database, `GAME_SESSIONS/${currentPin}`), {
      custom_questions: activeQuestionList
    });
  } catch (err) {
    console.error("Ralat mengemaskini Database:", err);
  }
}

// 4. RENDER QUESTION LIST DENGAN FUNGSI DRAG & DROP
function renderQuestionsList() {
  if (!sessionQuestionsContainer) return;
  sessionQuestionsContainer.innerHTML = '';

  if (activeQuestionList.length === 0) {
    sessionQuestionsContainer.innerHTML = '<p style="color: #64748b; font-size: 13px;">No questions selected. Add some!</p>';
    return;
  }

  activeQuestionList.forEach((qObj, index) => {
    const item = qObj.data;
    const card = document.createElement('div');
    card.className = 'session-question-row';
    
    // Dayakan draggable pada elemen
    card.draggable = true;
    card.dataset.index = index;
    card.style.cssText = "background: #0f172a; padding: 12px; border-radius: 6px; border: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; cursor: grab; user-select: none; transition: background 0.2s, border-color 0.2s; margin-bottom: 8px;";

    let titleText = item.question_text || item.instruction || `Code Snippet (Line ${item.bug_line})`;

    card.innerHTML = `
      <div style="display: flex; align-items: center; gap: 10px; flex: 1;">
        <span style="color: #64748b; font-size: 16px; cursor: grab;">☰</span>
        <div>
          <span class="session-question-mechanism">${String(item.mechanism || item.type || 'mcq').replace(/_/g, ' ')}</span>
          <div style="font-size: 13px; color: #fff; margin-top: 4px; font-weight: 500;">
            <strong>Q${index + 1}:</strong> ${titleText}
          </div>
        </div>
      </div>

      <button class="del-btn" style="background: #ef4444; color: #fff; border: none; border-radius: 4px; padding: 4px 8px; cursor: pointer; font-size: 12px;">Delete</button>
    `;

    // --- EVENT LISTENERS DRAG & DROP ---
    card.addEventListener('dragstart', (e) => {
      if (gameStarted) return;
      draggedIndex = index;
      card.style.opacity = '0.5';
      card.style.border = '1px dashed #38bdf8';
      e.dataTransfer.effectAllowed = 'move';
    });

    card.addEventListener('dragend', () => {
      card.style.opacity = '1';
      card.style.border = '1px solid #334155';
      draggedIndex = null;
    });

    card.addEventListener('dragover', (e) => {
      e.preventDefault();
      card.style.background = '#1e293b';
      card.style.borderColor = '#38bdf8';
    });

    card.addEventListener('dragleave', () => {
      card.style.background = '#0f172a';
      card.style.borderColor = '#334155';
    });

    card.addEventListener('drop', (e) => {
      if (gameStarted) return;
      e.preventDefault();
      card.style.background = '#0f172a';
      card.style.borderColor = '#334155';

      const targetIndex = parseInt(card.dataset.index);

      if (draggedIndex !== null && draggedIndex !== targetIndex) {
        // Alihkan item dalam array
        const draggedItem = activeQuestionList.splice(draggedIndex, 1)[0];
        activeQuestionList.splice(targetIndex, 0, draggedItem);

        // Render semula senarai & simpan ke DB
        isCustomized = true;
        renderQuestionsList();
        syncQuestionsToDB();
      }
    });

    // Delete Question
    card.querySelector('.del-btn').onclick = (e) => {
      e.stopPropagation();
      removeQuestion(index);
    };

    sessionQuestionsContainer.appendChild(card);
  });
}

function removeQuestion(index) {
  if (gameStarted) return;
  activeQuestionList.splice(index, 1);
  isCustomized = true;
  renderQuestionsList();
  syncQuestionsToDB();
}

// 5. ADD EXTRA QUESTION SETS MODAL
if (openAddQuestionModalBtn) {
  openAddQuestionModalBtn.onclick = () => {
    if (gameStarted) return;
    bankSetsContainer.innerHTML = '';
    Object.keys(cachedQuestionBank).forEach((setId) => {
      const set = cachedQuestionBank[setId];
      const div = document.createElement('div');
      div.style.cssText = "margin-bottom: 8px; display: flex; gap: 8px; align-items: center;";
      div.innerHTML = `
        <input type="checkbox" value="${setId}" class="add-set-cb" style="accent-color: #38bdf8;">
        <label style="font-size: 13px; color: #fff;">${set.title} (${Object.keys(set.items || {}).length} Qs)</label>
      `;
      bankSetsContainer.appendChild(div);
    });
    addSetModal.style.display = "flex";
  };
}

if (closeAddSetModalBtn) {
  closeAddSetModalBtn.onclick = () => addSetModal.style.display = "none";
}

if (confirmAddSetsBtn) {
  confirmAddSetsBtn.onclick = async () => {
    if (gameStarted) return;
    const checked = document.querySelectorAll('.add-set-cb:checked');
    const newSetIds = Array.from(checked).map(cb => cb.value);

    if (newSetIds.length > 0) {
      newSetIds.forEach((setId) => {
        const qSet = cachedQuestionBank[setId];
        if (qSet && qSet.items) {
          Object.keys(qSet.items).forEach((itemKey) => {
            activeQuestionList.push({
              setId: setId,
              itemKey: itemKey,
              data: qSet.items[itemKey]
            });
          });
        }
      });

      isCustomized = true;
      renderQuestionsList();
      await syncQuestionsToDB();
      
      if (addSetModal) addSetModal.style.display = "none";
    }
  };
}

// 6. START GAME (Termasuk session_type = "game")
if (startGameBtn) {
  startGameBtn.onclick = async () => {
    if (activeQuestionList.length === 0) {
      alert("Sila masukkan sekurang-kurangnya satu soalan!");
      return;
    }

    try {
      // Update status, session_type, dan compiled_questions
      await update(ref(database, `GAME_SESSIONS/${currentPin}`), {
        status: "IN_GAME",
        session_type: "game",
        compiled_questions: activeQuestionList
      });

      alert("Game Started! Students are entering the game field.");
    } catch (err) {
      console.error("Ralat semasa memulakan game:", err);
      alert("Gagal memulakan game. Sila cuba lagi.");
    }
  };
}
</file>

<file path="js/lecturer-whiteboard.js">
import { database } from "./firebase-config.js";

import {
    ref,
    set,
    onValue,
    onChildAdded,
    remove,
    push
} from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";


// ======================================================
// 1. GET PIN FROM URL
// ======================================================

const urlParams = new URLSearchParams(window.location.search);

const sessionPin = urlParams.get("pin");

if (!sessionPin) {
    alert("PIN Sesi tidak sah!");
    window.location.href = "index.html";
}


// ======================================================
// 2. GET CURRENT USER
// ======================================================

const userString = localStorage.getItem("loggedInUser");

const currentUser = userString
    ? JSON.parse(userString)
    : null;

if (!currentUser) {
    alert("Sila log masuk terlebih dahulu!");
    window.location.href = "login.html";
}


// ======================================================
// 3. DOM ELEMENTS
// ======================================================

const displayPin =
    document.getElementById("displayPin");

const roleBadge =
    document.getElementById("roleBadge");

const sessionTitleDisplay =
    document.getElementById("sessionTitleDisplay");

const canvas =
    document.getElementById("whiteboardCanvas");

const ctx =
    canvas.getContext("2d");

const boardContainer =
    document.getElementById("boardContainer");

const clearBtn =
    document.getElementById("clearBtn");

const exitBtn =
    document.getElementById("exitBtn");

const addNoteBtn =
    document.getElementById("addNoteBtn");

const penBtn =
    document.getElementById("penBtn");

const eraserBtn =
    document.getElementById("eraserBtn");

const colorPicker =
    document.getElementById("colorPicker");

const openCodeBtn = document.getElementById("openCodeBtn");
const codeEditorPanel = document.getElementById("codeEditorPanel");
const closeCodeBtn = document.getElementById("closeCodeBtn");
const publishCodeBtn = document.getElementById("publishCodeBtn");
const codeTitleInput = document.getElementById("codeTitleInput");
const codeLanguageInput = document.getElementById("codeLanguageInput");
const codeInput = document.getElementById("codeInput");
const projectorBtn = document.getElementById("projectorBtn");
const exitProjectorBtn = document.getElementById("exitProjectorBtn");
const sharedCodeCard = document.getElementById("sharedCodeCard");
const sharedCodeTitle = document.getElementById("sharedCodeTitle");
const sharedCodeLanguage = document.getElementById("sharedCodeLanguage");
const sharedCodeText = document.getElementById("sharedCodeText");
const codeSyncStatus = document.getElementById("codeSyncStatus");


// ======================================================
// 4. BASIC VARIABLES
// ======================================================

let isDrawing = false;

let currentMode = "pen";

let currentColor = "#38bdf8";

let isLecturer = false;

let lastX = 0;

let lastY = 0;
let codeSaveTimer = null;
let publishedCode = null;


// ======================================================
// 5. DISPLAY PIN
// ======================================================

displayPin.textContent = `PIN: ${sessionPin}`;


// ======================================================
// 6. FIREBASE SESSION
// ======================================================

const sessionRef = ref(
    database,
    `GAME_SESSIONS/${sessionPin}`
);


// ======================================================
// 7. CHECK SESSION + ROLE
// ======================================================

onValue(sessionRef, (snapshot) => {

    if (!snapshot.exists()) {

        alert(
            "Sesi Whiteboard ini telah ditamatkan!"
        );

        window.location.href =
            "index.html";

        return;
    }


    const sessionData = snapshot.val();


    // --------------------------------------------------
    // SESSION TITLE
    // --------------------------------------------------

    sessionTitleDisplay.textContent =
        sessionData.session_title ||
        "Whiteboard Session";


    // --------------------------------------------------
    // CHECK ROLE
    // --------------------------------------------------

    if (
        currentUser &&
        (
            currentUser.user_id === sessionData.owner_id ||
            currentUser.role === "lecturer"
        )
    ) {

        isLecturer = true;

        roleBadge.textContent =
            "Lecturer";

        roleBadge.style.background =
            "#a855f7";

        clearBtn.style.display =
            "flex";

        canvas.style.cursor =
            "crosshair";

    } else {

        isLecturer = false;

        roleBadge.textContent =
            "Student";

        roleBadge.style.background =
            "#10b981";

        clearBtn.style.display =
            "none";

        canvas.style.cursor =
            "not-allowed";
    }

});


// ======================================================
// 8. CANVAS SIZE
// ======================================================

function resizeCanvas() {

    const oldWidth = canvas.width;
    const oldHeight = canvas.height;

    const newWidth =
        boardContainer.clientWidth;

    const newHeight =
        boardContainer.clientHeight;


    if (
        oldWidth === newWidth &&
        oldHeight === newHeight
    ) {
        return;
    }


    canvas.width = newWidth;
    canvas.height = newHeight;


    // Redraw semua existing drawings
    redrawAllDrawings();
}


window.addEventListener(
    "resize",
    resizeCanvas
);


// Initial canvas size
canvas.width =
    boardContainer.clientWidth;

canvas.height =
    boardContainer.clientHeight;


// ======================================================
// 9. FIREBASE WHITEBOARD DRAWINGS PATH
// ======================================================

const drawingsRef = ref(
    database,
    `GAME_SESSIONS/${sessionPin}/whiteboard_drawings`
);


// ======================================================
// 10. FIREBASE CLEAR PATH
// ======================================================

const clearSignalRef = ref(
    database,
    `GAME_SESSIONS/${sessionPin}/whiteboard_clear`
);


// ======================================================
// 11. GET MOUSE / TOUCH COORDINATES
// ======================================================

function getCoordinates(e) {

    const rect =
        canvas.getBoundingClientRect();


    let clientX;
    let clientY;


    if (e.touches && e.touches.length > 0) {

        clientX =
            e.touches[0].clientX;

        clientY =
            e.touches[0].clientY;

    } else {

        clientX =
            e.clientX;

        clientY =
            e.clientY;
    }


    return {

        x:
            clientX - rect.left,

        y:
            clientY - rect.top

    };

}


// ======================================================
// 12. START DRAWING
// ======================================================

function startDrawing(e) {

    if (!isLecturer) {
        return;
    }


    isDrawing = true;


    const coords =
        getCoordinates(e);


    lastX =
        coords.x;

    lastY =
        coords.y;


    // Draw a small dot when clicking
    ctx.save();
    ctx.globalCompositeOperation = currentMode === "eraser" ? "destination-out" : "source-over";
    ctx.beginPath();

    ctx.arc(
        lastX,
        lastY,
        currentMode === "eraser" ? 10 : 1.5,
        0,
        Math.PI * 2
    );

    ctx.fillStyle =
        currentMode === "eraser"
            ? "#020617"
            : currentColor;

    ctx.fill();
    ctx.restore();
}


// ======================================================
// 13. STOP DRAWING
// ======================================================

function stopDrawing() {

    isDrawing = false;

    ctx.save();
    ctx.globalCompositeOperation = currentMode === "eraser" ? "destination-out" : "source-over";
    ctx.beginPath();
}


// ======================================================
// 14. DRAW
// ======================================================

function draw(e) {

    if (!isDrawing) {
        return;
    }


    if (!isLecturer) {
        return;
    }


    const coords =
        getCoordinates(e);


    const currentX =
        coords.x;

    const currentY =
        coords.y;


    // ==================================================
    // LOCAL DRAWING
    // ==================================================

    ctx.beginPath();

    ctx.moveTo(
        lastX,
        lastY
    );

    ctx.lineTo(
        currentX,
        currentY
    );


    ctx.strokeStyle = currentColor;


    ctx.lineWidth =
        currentMode === "eraser"
            ? 20
            : 3;


    ctx.lineCap =
        "round";

    ctx.lineJoin =
        "round";

    ctx.stroke();
    ctx.restore();


    // ==================================================
    // FIREBASE DATA
    // ==================================================

    const lineSegment = {

        x0:
            lastX / canvas.width,

        y0:
            lastY / canvas.height,

        x1:
            currentX / canvas.width,

        y1:
            currentY / canvas.height,

        color:
            currentColor,

        mode:
            currentMode,

        size:
            currentMode === "eraser"
                ? 20
                : 3
    };


    // ==================================================
    // SAVE TO FIREBASE
    // ==================================================

    push(
        drawingsRef,
        lineSegment
    ).catch((error) => {

        console.error(
            "Firebase drawing error:",
            error
        );

    });


    // Update last position

    lastX =
        currentX;

    lastY =
        currentY;
}


// ======================================================
// 15. DRAW FIREBASE SEGMENT
// ======================================================

function drawLineSegment(line) {

    if (!line) {
        return;
    }


    const x0 =
        line.x0 * canvas.width;

    const y0 =
        line.y0 * canvas.height;

    const x1 =
        line.x1 * canvas.width;

    const y1 =
        line.y1 * canvas.height;


    ctx.save();
    ctx.globalCompositeOperation = line.mode === "eraser" ? "destination-out" : "source-over";
    ctx.beginPath();


    ctx.moveTo(
        x0,
        y0
    );


    ctx.lineTo(
        x1,
        y1
    );


    ctx.strokeStyle =
        line.color || "#38bdf8";


    ctx.lineWidth =
        line.size || 3;


    ctx.lineCap =
        "round";

    ctx.lineJoin =
        "round";


    ctx.stroke();
    ctx.restore();
}


// ======================================================
// 16. REDRAW ALL DRAWINGS
// ======================================================

function redrawAllDrawings() {

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    onValue(
        drawingsRef,
        (snapshot) => {

            if (!snapshot.exists()) {
                return;
            }


            const drawings =
                snapshot.val();


            Object.values(drawings)
                .forEach((line) => {

                    drawLineSegment(line);

                });

        },
        {
            onlyOnce: true
        }
    );
}


// ======================================================
// 17. REAL-TIME DRAWING LISTENER
// ======================================================

onChildAdded(
    drawingsRef,
    (snapshot) => {

        if (!snapshot.exists()) {
            return;
        }


        const line =
            snapshot.val();


        drawLineSegment(line);

    }
);


// ======================================================
// 18. CLEAR BOARD LISTENER
// ======================================================

onValue(
    clearSignalRef,
    (snapshot) => {

        if (!snapshot.exists()) {
            return;
        }


        ctx.clearRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

    }
);


// ======================================================
// 19. MOUSE EVENTS
// ======================================================

canvas.addEventListener(
    "mousedown",
    startDrawing
);


canvas.addEventListener(
    "mousemove",
    draw
);


canvas.addEventListener(
    "mouseup",
    stopDrawing
);


canvas.addEventListener(
    "mouseleave",
    stopDrawing
);


// ======================================================
// 20. TOUCH EVENTS
// ======================================================

canvas.addEventListener(
    "touchstart",
    (e) => {

        e.preventDefault();

        startDrawing(e);

    },
    { passive: false }
);


canvas.addEventListener(
    "touchmove",
    (e) => {

        e.preventDefault();

        draw(e);

    },
    { passive: false }
);


canvas.addEventListener(
    "touchend",
    (e) => {

        e.preventDefault();

        stopDrawing();

    },
    { passive: false }
);


// ======================================================
// 21. PEN BUTTON
// ======================================================

penBtn.addEventListener(
    "click",
    (e) => {

        currentMode =
            "pen";

        setActiveTool(
            e.currentTarget
        );

    }
);


// ======================================================
// 22. ERASER BUTTON
// ======================================================

eraserBtn.addEventListener(
    "click",
    (e) => {

        currentMode =
            "eraser";

        setActiveTool(
            e.currentTarget
        );

    }
);


// ======================================================
// 23. COLOR PICKER
// ======================================================

colorPicker.addEventListener(
    "input",
    (e) => {

        currentColor =
            e.target.value;

        // Automatically switch back to pen
        currentMode =
            "pen";

        setActiveTool(
            penBtn
        );

    }
);


// ======================================================
// 24. ACTIVE TOOL
// ======================================================

function setActiveTool(targetBtn) {

    document
        .querySelectorAll(".tool-btn")
        .forEach((btn) => {

            btn.classList.remove(
                "active"
            );

        });


    targetBtn.classList.add(
        "active"
    );

}


// ======================================================
// 25. STICKY NOTES FIREBASE PATH
// ======================================================

const notesRef = ref(
    database,
    `GAME_SESSIONS/${sessionPin}/whiteboard_notes`
);


// ======================================================
// 26. ADD STICKY NOTE
// ======================================================

addNoteBtn.addEventListener(
    "click",
    () => {

        const colors = [
            "#fef08a",
            "#fbcfe8",
            "#bbf7d0",
            "#bae6fd"
        ];


        const randomColor =
            colors[
                Math.floor(
                    Math.random() *
                    colors.length
                )
            ];


        const newNote = {

            text:
                "Tulis nota/jawapan...",

            x:
                100,

            y:
                100,

            color:
                randomColor,

            author:
                currentUser.name ||
                "Lecturer"

        };


        push(
            notesRef,
            newNote
        ).catch((error) => {

            console.error(
                "Add note error:",
                error
            );

        });

    }
);


// ======================================================
// 27. DISPLAY STICKY NOTES
// ======================================================

onValue(
    notesRef,
    (snapshot) => {

        // Remove existing notes
        document
            .querySelectorAll(
                ".sticky-note"
            )
            .forEach((el) => {

                el.remove();

            });


        if (!snapshot.exists()) {
            return;
        }


        const notes =
            snapshot.val();


        Object.keys(notes)
            .forEach((noteId) => {

                const note =
                    notes[noteId];


                const noteDiv =
                    document.createElement(
                        "div"
                    );


                noteDiv.className =
                    "sticky-note";


                noteDiv.style.backgroundColor =
                    note.color;


                noteDiv.style.left =
                    `${note.x}px`;


                noteDiv.style.top =
                    `${note.y}px`;


                noteDiv.innerHTML = `
                    <textarea>${note.text || ""}</textarea>

                    <div class="author">
                        - ${note.author || "Lecturer"}
                    </div>
                `;


                const textarea =
                    noteDiv.querySelector(
                        "textarea"
                    );


                // Update note text
                textarea.addEventListener(
                    "change",
                    (e) => {

                        set(
                            ref(
                                database,
                                `GAME_SESSIONS/${sessionPin}/whiteboard_notes/${noteId}/text`
                            ),
                            e.target.value
                        );

                    }
                );


                // Only lecturer can edit notes
                if (!isLecturer) {

                    textarea.disabled =
                        true;

                }


                boardContainer.appendChild(
                    noteDiv
                );

            });

    }
);


// ======================================================
// 28. CLEAR ALL WHITEBOARD
// ======================================================

clearBtn.addEventListener(
    "click",
    async () => {

        if (!isLecturer) {
            return;
        }


        const confirmed =
            confirm(
                "Adakah anda pasti ingin memadam seluruh papan putih?"
            );


        if (!confirmed) {
            return;
        }


        try {

            // Remove drawings
            await remove(
                drawingsRef
            );


            // Remove notes
            await remove(
                notesRef
            );


            // Send clear signal
            await set(
                clearSignalRef,
                Date.now()
            );


            // Clear lecturer canvas
            ctx.clearRect(
                0,
                0,
                canvas.width,
                canvas.height
            );


        } catch (error) {

            console.error(
                "Clear board error:",
                error
            );


            alert(
                "Gagal memadam whiteboard."
            );

        }

    }
);


// ======================================================
// 29. EXIT SESSION
// ======================================================

exitBtn.addEventListener(
    "click",
    () => {

        if (isLecturer) {

            window.location.href =
                "create-game-session.html";

        } else {

            window.location.href =
                "student-dashboard.html";

        }

    }
);


// ======================================================
// 30. FINAL CANVAS RESIZE
// ======================================================

setTimeout(
    () => {

        canvas.width =
            boardContainer.clientWidth;

        canvas.height =
            boardContainer.clientHeight;

        redrawAllDrawings();

    },
    200
);

const whiteboardViewRef = ref(
    database,
    `GAME_SESSIONS/${sessionPin}/whiteboard_view`
);

const whiteboardCodeRef = ref(
    database,
    `GAME_SESSIONS/${sessionPin}/whiteboard_code`
);

onValue(whiteboardViewRef, (snapshot) => {
    const view = snapshot.val() || {};
    document.body.classList.toggle("projector-mode", Boolean(view.projector_mode));
    if (projectorBtn) projectorBtn.classList.toggle("active", Boolean(view.projector_mode));
    if (exitProjectorBtn) exitProjectorBtn.hidden = !view.projector_mode;
});

onValue(whiteboardCodeRef, (snapshot) => {
    const code = snapshot.val();
    publishedCode = code || null;
    if (!sharedCodeCard) return;
    sharedCodeCard.hidden = !code?.code;
    if (!code) return;
    sharedCodeTitle.textContent = code.title || "Programming example";
    sharedCodeLanguage.textContent = code.language || "C++";
    sharedCodeText.textContent = code.code || "";
    const editorFocused = [codeTitleInput, codeLanguageInput, codeInput].includes(document.activeElement);
    if (codeEditorPanel && !codeEditorPanel.hidden && !editorFocused) {
        codeTitleInput.value = code.title || "Programming example";
        codeLanguageInput.value = code.language || "C++";
        codeInput.value = code.code || "";
    }
});

openCodeBtn.addEventListener("click", () => {
    if (!isLecturer) return;
    codeEditorPanel.hidden = !codeEditorPanel.hidden;
    if (!codeEditorPanel.hidden && publishedCode) {
        codeTitleInput.value = publishedCode.title || "Programming example";
        codeLanguageInput.value = publishedCode.language || "C++";
        codeInput.value = publishedCode.code || "";
    }
});

closeCodeBtn.addEventListener("click", () => {
    codeEditorPanel.hidden = true;
});

async function publishCode() {
    if (!isLecturer) return;
    const code = codeInput.value.trim();
    if (!code) {
        await remove(whiteboardCodeRef);
        if (codeSyncStatus) codeSyncStatus.textContent = "Code display cleared.";
        return;
    }

    try {
        await set(whiteboardCodeRef, {
            title: codeTitleInput.value.trim() || "Programming example",
            language: codeLanguageInput.value,
            code,
            updated_by: currentUser.name || "Lecturer",
            updated_at: Date.now()
        });
        if (codeSyncStatus) codeSyncStatus.textContent = "Live on student screens.";
    } catch (error) {
        console.error("Code publish error:", error);
        if (codeSyncStatus) codeSyncStatus.textContent = "Could not sync code. Try again.";
    }
}

function scheduleCodePublish() {
    if (!isLecturer) return;
    if (codeSyncStatus) codeSyncStatus.textContent = "Syncing edits…";
    clearTimeout(codeSaveTimer);
    codeSaveTimer = setTimeout(publishCode, 450);
}

[codeTitleInput, codeLanguageInput, codeInput].forEach((control) => {
    control.addEventListener("input", scheduleCodePublish);
    control.addEventListener("change", scheduleCodePublish);
});

publishCodeBtn.addEventListener("click", publishCode);

projectorBtn.addEventListener("click", async () => {
    if (!isLecturer) return;
    try {
        await document.documentElement.requestFullscreen?.();
    } catch (error) {
        console.info("Fullscreen unavailable; using projector layout.", error);
    }
    await set(ref(database, `GAME_SESSIONS/${sessionPin}/whiteboard_view/projector_mode`), true);
});

exitProjectorBtn.addEventListener("click", async () => {
    if (!isLecturer) return;
    if (document.fullscreenElement) await document.exitFullscreen().catch(() => {});
    await set(ref(database, `GAME_SESSIONS/${sessionPin}/whiteboard_view/projector_mode`), false);
});

document.addEventListener("fullscreenchange", () => {
    if (isLecturer && !document.fullscreenElement && document.body.classList.contains("projector-mode")) {
        set(ref(database, `GAME_SESSIONS/${sessionPin}/whiteboard_view/projector_mode`), false);
    }
});
