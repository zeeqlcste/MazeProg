      padding: 16px;
      margin-bottom: 15px;
      position: relative;
    }
    .question-card-item .remove-q-btn {
      position: absolute;
      top: 12px;
      right: 12px;
      color: #ef4444;
      cursor: pointer;
      font-weight: bold;
      font-size: 16px;
    }
    .form-grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 12px;
    }
    .form-input-style {
      width: 100%;
      padding: 8px 12px;
