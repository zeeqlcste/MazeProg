  <link rel="stylesheet" href="css/style.css">
  <style>
    .lb-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .lb-header h3 { margin: 0; }
    .lb-summary { display: flex; gap: 8px; flex-wrap: wrap; }
    .lb-summary span { background: rgba(168, 85, 247, 0.15); border: 1px solid var(--line, #3a3650); color: var(--text, #f3e8ff); padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600; }
    .lb-table-wrap { overflow-x: auto; }
    .lb-table { width: 100%; min-width: 780px; border-collapse: collapse; text-align: left; font-size: 13px; }
    .lb-table th, .lb-table td { padding: 10px 12px; border-bottom: 1px solid var(--line, #3a3650); vertical-align: middle; }
    .lb-table th { color: var(--muted, #c4b5fd); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
    .lb-table td { color: var(--text, #f3e8ff); }
    .lb-rank { width: 56px; font-weight: 700; font-size: 16px; }
    .lb-row-top td { background: rgba(168, 85, 247, 0.08); }
    .lb-score { font-weight: 700; font-size: 15px; color: var(--brass, #e9d5ff); }
    .lb-sub { display: block; margin-top: 2px; color: var(--muted, #c4b5fd); font-size: 11px; text-transform: uppercase; }
