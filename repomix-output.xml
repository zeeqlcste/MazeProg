<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Game Arena</title>
  <link rel="stylesheet" href="css/style.css">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
    body { background: #090d16; color: #fff; min-height: 100vh; display: flex; justify-content: center; align-items: center; padding: 20px; }
    
    .game-card { width: 100%; max-width: 800px; background: #111827; border: 1px solid #1f2937; border-radius: 16px; padding: 28px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.5); }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .badge { background: #3b82f6; color: #fff; padding: 4px 12px; border-radius: 9999px; font-weight: bold; font-size: 12px; }
    .score-badge { background: #064e3b; color: #34d399; padding: 6px 16px; border-radius: 8px; font-weight: bold; font-size: 18px; border: 1px solid #059669; }

    .q-title { font-size: 20px; font-weight: 700; color: #f3f4f6; margin-bottom: 16px; }
    .q-code { background: #030712; padding: 16px; border-radius: 8px; border: 1px solid #1f2937; font-family: monospace; color: #38bdf8; margin-bottom: 20px; white-space: pre-wrap; font-size: 14px; }

    /* --- STYLES MECHANISM 1: MCQ --- */
    .mcq-options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .mcq-option-btn { background: #1f2937; border: 2px solid #374151; padding: 16px; border-radius: 12px; color: #fff; display: flex; gap: 12px; align-items: center; cursor: pointer; transition: 0.2s; text-align: left; }
    .mcq-option-btn:hover { border-color: #3b82f6; background: #374151; }
    .opt-label { background: #3b82f6; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: bold; font-size: 14px; }

    /* --- STYLES MECHANISM 2: FIND BUG --- */
    .bug-editor-wrapper { background: #030712; border: 1px solid #1f2937; border-radius: 8px; padding: 16px; }
    .bug-hint { font-size: 13px; color: #fbbf24; margin-bottom: 10px; }
    .editor-line { display: flex; gap: 16px; padding: 8px; border-radius: 4px; cursor: pointer; font-family: monospace; }
    .editor-line:hover { background: #1f2937; }
    .editor-line.active-bug-line { background: #7f1d1d; border: 1px solid #ef4444; color: #fca5a5; }
    .line-num { color: #4b5563; user-select: none; }
    .action-btn-bug, .action-btn-parsons, .action-btn-fitb { width: 100%; margin-top: 16px; background: #10b981; border: none; padding: 14px; color: #fff; font-weight: bold; border-radius: 8px; cursor: pointer; }
    .action-btn-bug:disabled { background: #374151; cursor: not-allowed; }

    /* --- STYLES MECHANISM 3: REARRANGE / PARSONS --- */
    .parsons-hint { font-size: 13px; color: #38bdf8; margin-bottom: 10px; }
    .parsons-list { display: flex; flex-direction: column; gap: 8px; }
    .parsons-card { background: #1f2937; border: 1px solid #374151; padding: 12px; border-radius: 8px; cursor: grab; display: flex; align-items: center; gap: 12px; }
    .parsons-card.dragging { opacity: 0.4; border: 2px dashed #38bdf8; }
    .drag-handle { color: #6b7280; font-size: 18px; }

    /* --- STYLES MECHANISM 4: FILL IN BLANK --- */
    .fitb-terminal-wrapper { background: #000; border: 1px solid #22c55e; border-radius: 8px; overflow: hidden; }
    .terminal-header { background: #111827; padding: 8px 12px; display: flex; align-items: center; gap: 6px; }
    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .dot.red { background: #ef4444; } .dot.yellow { background: #eab308; } .dot.green { background: #22c55e; }
    .term-title { font-size: 11px; color: #6b7280; margin-left: 10px; font-family: monospace; }
    .terminal-body { padding: 16px; }
    .term-prompt { color: #22c55e; font-family: monospace; font-size: 14px; display: block; margin-bottom: 8px; }
    .term-input { width: 100%; background: transparent; border: none; border-bottom: 2px solid #22c55e; color: #fff; font-family: monospace; font-size: 16px; padding: 8px 0; outline: none; }

    /* Feedback Overlay */
    .feedback-box { margin-top: 16px; padding: 12px; border-radius: 8px; font-weight: bold; text-align: center; display: none; }
    .feedback-correct { background: #064e3b; color: #34d399; }
    .feedback-wrong { background: #7f1d1d; color: #fca5a5; }
  </style>
</head>
<body class="student-arena">

  <div class="game-card">
    <a class="site-brand site-brand--micro" href="student-dashboard.html" aria-label="MazeProg student dashboard"><img src="assets/mazeprog-logo.png" alt="MazeProg"></a>
    <div class="top-bar">
      <span id="mechBadge" class="badge">MECHANISM</span>
      <span id="questionProgress" style="font-size: 14px; color: #9ca3af;">Soalan 1</span>
      <div id="scoreDisplay" class="score-badge">Score: 0</div>
    </div>

    <div style="margin-bottom: 18px; background: rgba(15, 23, 42, 0.6); padding: 10px 14px; border-radius: 8px;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 6px; color: #94a3b8; font-size: 13px;">
        <span>Masa berbaki</span>
        <span id="questionTimerText" style="color: #38bdf8; font-weight: bold;">--s</span>
      </div>
      <div style="height: 6px; background: #1e293b; border-radius: 4px; overflow: hidden;">
        <div id="questionTimerBar" style="width: 100%; height: 100%; background: #10b981; transition: width 1s linear, background-color 0.3s;"></div>
      </div>
    </div>

    <div id="questionTitle" class="q-title">Loading Question...</div>
    <div id="questionCodeBlock" class="q-code" style="display: none;"></div>

    <!-- Container tempat mechanism di-render -->
    <div id="mechanismContainer"></div>

    <div id="feedbackBox" class="feedback-box"></div>
  </div>

  <script type="module" src="js/student-game.js"></script>
</body>
</html>
