            0% {
                opacity: 0.6;
            }

            50% {
                opacity: 1;
            }

            100% {
                opacity: 0.6;
            }

        }

    </style>

</head>


<body>


    <!-- HEADER -->

    <header class="wb-header">

        <div class="wb-title-group">

            <a class="site-brand site-brand--micro" href="student-dashboard.html" aria-label="MazeProg student dashboard">
                <img src="assets/mazeprog-logo.png" alt="MazeProg">
