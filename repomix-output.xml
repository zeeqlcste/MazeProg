            background: #020617;

            cursor: not-allowed;

            width: 100%;

            height: 100%;
        }

        .shared-code-card {
            position: absolute;
            z-index: 4;
            top: 18px;
            left: 18px;
            width: min(620px, calc(100% - 36px));
            max-height: calc(100% - 36px);
            overflow: auto;
            color: #ecf5ef;
            background: rgba(10, 17, 14, 0.95);
            border: 1px solid rgba(96, 214, 174, 0.45);
            border-radius: 8px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
