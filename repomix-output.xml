            display: inline-flex;

            align-items: center;

            gap: 4px;
        }


        /* WHITEBOARD */

        .board-container {

            flex: 1;

            position: relative;

            background: #020617;

            width: 100%;

            height:
                calc(100vh - 60px);

            overflow: hidden;
        }


        canvas {

